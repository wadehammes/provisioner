# Copy to .env.local (or run `vercel env pull`). Never commit real secrets.

# Deployment target: local | staging | production
ENVIRONMENT=

# Contentful (server-only)
CONTENTFUL_SPACE_ID=
CONTENTFUL_CONTENT_DELIVERY_API_KEY=
CONTENTFUL_PREVIEW_API_KEY=
CONTENTFUL_PREVIEW_SECRET=

# Contentful Management API — `pnpm types:contentful` only (server-only)
CONTENTFUL_CMA_TOKEN=

# Resend (server-only)
RESEND_API_KEY=
RESEND_GENERAL_AUDIENCE_ID=

# HubSpot (server-only)
HUBSPOT_PORTAL_ID=
HUBSPOT_LEAD_GENERATION_FORM_ID=
HUBSPOT_API_KEY=

# Google Analytics — server-only (read in root layout)
GA_MEASUREMENT_ID=

# reCAPTCHA site key — public; exposed to the browser via NEXT_PUBLIC_
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

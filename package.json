{
  "name": "next-provisioner",
  "version": "0.0.0",
  "packageManager": "pnpm@11.7.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev -p 7777 --webpack",
    "build": "next build && make sitemap",
    "start": "next start -p 7777",
    "export": "next export",
    "biome:fix": "biome format --write .",
    "tsc:ci": "tsc --strict",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:changed": "biome check --changed --since origin/main --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:all": "pnpm lint:changed && pnpm lint:css:fix",
    "test:ci": "jest --passWithNoTests",
    "types:contentful": "export $(cat .env.local | sed '/^#/d; s/[$\"]//g'); cf-content-types-generator -s $CONTENTFUL_SPACE_ID -t $CONTENTFUL_CMA_TOKEN -o src/contentful/types -r -g && biome format --write src/contentful/types"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.2.1",
    "@contentful/rich-text-types": "^17.2.7",
    "@faker-js/faker": "^10.4.0",
    "@jest/types": "^30.4.1",
    "@next/third-parties": "^16.2.9",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query": "^5.101.0",
    "classnames": "^2.5.1",
    "contentful": "^11.12.5",
    "gsap": "^3.15.0",
    "html-react-parser": "^6.1.3",
    "jest-mock": "^30.4.1",
    "next": "^16.2.9",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.3.1",
    "postcss-syntax": "^0.36.2",
    "react": "^19.2.7",
    "react-aria": "^3.49.0",
    "react-dom": "^19.2.7",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.79.0",
    "react-intersection-observer": "^10.0.3",
    "react-player": "^3.4.0",
    "react-toastify": "^11.1.0",
    "resend": "6.12.4",
    "schema-dts": "^2.0.0",
    "swiper": "^12.2.0",
    "tslib": "^2.8.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-google-recaptcha": "^2.1.9",
    "cf-content-types-generator": "^3.0.1",
    "csstype": "^3.2.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react-is": "^19.2.7",
    "stylelint": "^17.13.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-plugin-css-modules": "^5.2.0"
  }
}

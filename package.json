{
  "name": "next-provisioner",
  "version": "0.0.0",
  "packageManager": "pnpm@11.20.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev -p 7777",
    "build": "next build && make sitemap",
    "start": "next start -p 7777",
    "export": "next export",
    "biome:fix": "biome format --write .",
    "tsc:ci": "tsc --strict",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:changed": "biome check --changed --since origin/staging --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:all": "pnpm tsc:ci && pnpm lint:changed && pnpm lint:css:fix && pnpm knip:ci",
    "test:ci": "jest --passWithNoTests",
    "knip": "knip",
    "knip:ci": "knip --no-progress",
    "types:contentful": "export $(cat .env.local | sed '/^#/d; s/[$\"]//g'); cf-content-types-generator -s $CONTENTFUL_SPACE_ID -t $CONTENTFUL_CMA_TOKEN -o src/contentful/types -r -g && biome format --write src/contentful/types"
  },
  "dependencies": {
    "@contentful/rich-text-react-renderer": "^16.2.2",
    "@contentful/rich-text-types": "^17.2.7",
    "@jest/types": "^30.4.1",
    "@next/third-parties": "^16.3.0",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query": "^5.101.4",
    "classnames": "^2.5.1",
    "contentful": "^11.12.7",
    "gsap": "^3.15.0",
    "html-react-parser": "^6.1.5",
    "next": "^16.3.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.3.2",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-dom": "^19.2.8",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.84.0",
    "react-intersection-observer": "^11.0.0",
    "react-player": "^3.4.0",
    "react-toastify": "^11.1.0",
    "resend": "6.18.1",
    "swiper": "^14.0.7",
    "tslib": "^2.8.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-google-recaptcha": "^2.1.9",
    "cf-content-types-generator": "^3.0.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "knip": "^6.31.0",
    "stylelint": "^17.14.1",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^7.0.2",
    "typescript-plugin-css-modules": "^5.2.0"
  }
}
